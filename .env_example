OpenWeatherMapAPIKey=
NASAAPIKey=
# N2YOAPIKey no longer needed — ISS passes now computed via Skyfield + Celestrak TLE

# Optional: Sentry DSN for error monitoring (leave unset to disable)
SENTRY_DSN=

# Optional: comma-separated list of valid consumer API keys.
# When set, all requests must supply a matching X-API-Key header.
# Leave empty to run in open mode (no auth required).
LAPO_API_KEYS=
